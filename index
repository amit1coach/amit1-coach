.tabb{border:none;border-bottom:2px solid transparent;background:transparent;padding:8px 18px;font-size:14px;cursor:pointer;color:#8A9BB0;font-weight:400;margin-bottom:-1px}
.tabb.act{border-bottom-color:#F5A623;color:#0F1117;font-weight:600}
.wnb{border:.5px solid #E2E8F0;border-radius:5px;padding:5px 9px;cursor:pointer;background:#fff;font-size:13px}
.toast{position:fixed;top:16px;right:16px;z-index:999;border-radius:8px;padding:10px 18px;font-size:14px;font-weight:500;box-shadow:0 4px 16px rgba(0,0,0,.1)}
.dr{border:.5px solid #E2E8F0;border-radius:10px;padding:12px 14px;margin-bottom:8px}
.wtb{font-size:12px;font-weight:700;padding:2px 9px;border-radius:4px;display:inline-block}
.stb{font-size:11px;font-weight:600;padding:2px 8px;border-radius:4px;display:inline-block}
.mono{font-family:'DM Mono',monospace}
.sblk{background:#F7F8FA;border:.5px solid #E2E8F0;border-radius:8px;padding:10px 12px;margin-bottom:8px}
.row{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.spin{display:inline-block;width:20px;height:20px;border:2px solid #F5A623;border-top-color:transparent;border-radius:50%;animation:spin .7s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.login-box{background:#fff;border-radius:16px;padding:2rem;width:100%;max-width:400px;border:.5px solid #E2E8F0;box-shadow:0 8px 32px rgba(0,0,0,.1)}
@media(max-width:600px){.gr2{grid-template-columns:1fr!important}.strow{flex-wrap:wrap}.strow .sc{min-width:45%}}
