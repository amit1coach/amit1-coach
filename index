        h("div",{style:{fontSize:10,color:"#8A9BB0",fontWeight:600}},"Reps"),
        h("div",{style:{fontSize:10,color:"#8A9BB0",fontWeight:600}},"Dist (m)"),
        h("div",{style:{fontSize:10,color:"#8A9BB0",fontWeight:600}},"= km"),
        h("div")
      ),
      rows.map((row,i)=>{
        const sets=parseFloat(row.sets)||1, reps=parseFloat(row.reps)||0, dist=parseFloat(row.distM)||0;
        const rowKm=(sets*reps*dist/1000);
        return h("div",{key:i,style:{display:"grid",gridTemplateColumns:"80px 80px 80px 1fr 24px",gap:6,marginBottom:6,alignItems:"center"}},
          h("input",{type:"number",value:row.sets,onChange:e=>updateRow(i,"sets",e.target.value),placeholder:"2",className:"mono",style:{padding:"5px 7px",fontSize:13}}),
          h("input",{type:"number",value:row.reps,onChange:e=>updateRow(i,"reps",e.target.value),placeholder:"4",className:"mono",style:{padding:"5px 7px",fontSize:13}}),
          h("input",{type:"number",value:row.distM,onChange:e=>updateRow(i,"distM",e.target.value),placeholder:"120",className:"mono",style:{padding:"5px 7px",fontSize:13}}),
          h("div",{style:{fontSize:12,color:"#0F1117",fontFamily:"monospace",padding:"0 4px"}},
            rowKm>0 ? rowKm.toFixed(3)+" km" : "—"
          ),
          rows.length>1
            ? h("button",{onClick:()=>removeRow(i),style:{border:"none",background:"none",cursor:"pointer",color:"#E05C5C",fontSize:16,lineHeight:1,padding:0}},"×")
            : h("div")
        );
      }),
      h("div",{style:{display:"flex",alignItems:"center",justifyContent:"space-between",marginTop:4}},
        h("button",{onClick:addRow,className:"btn btns",style:{fontSize:11}},"+ Add row"),
        totalHillKm>0&&h("div",{style:{fontSize:13,fontWeight:700,color:"#0F1117"}},
