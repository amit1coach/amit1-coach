const TypedRepFields = ({type, existing, onChange, planPart}) => {
  const [f, setF] = useState(()=>{
    const base = existing||{};
    // For hills: if no existing report data, pre-populate from plan's hillRows
    if (type==="hills" && !base.hillRows && planPart && getHillRows(planPart).length>0) {
      return {...base, hillRows: getHillRows(planPart).map(r=>({...r}))};
    }
    return base;
  });
  const s = (k,v) => { const nx={...f,[k]:v}; setF(nx); onChange(nx); };

  if (type==="easy"||type==="recovery") return h("div",{style:{display:"grid",gridTemplateColumns:"1fr 1fr",gap:10,marginBottom:8}},
    h("div",null,h("label",{className:"lbl"},"Actual distance (km)"),h("input",{type:"number",value:f.actualDistance||"",onChange:e=>s("actualDistance",e.target.value),placeholder:"0",className:"mono"})),
    h("div",null,h("label",{className:"lbl"},"Actual pace (mm:ss)"),h("input",{value:f.actualPace||"",onChange:e=>s("actualPace",e.target.value),placeholder:"e.g. 5:30",className:"mono"}))
  );

  if (type==="tempo") return h("div",{style:{display:"grid",gridTemplateColumns:"1fr 1fr",gap:10,marginBottom:8}},
    h("div",null,h("label",{className:"lbl"},"Actual total distance (km)"),h("input",{type:"number",value:f.actualDistance||"",onChange:e=>s("actualDistance",e.target.value),placeholder:"0",className:"mono"})),
    h("div",null,h("label",{className:"lbl"},"Tempo pace (mm:ss)"),h("input",{value:f.tempoPace||"",onChange:e=>s("tempoPace",e.target.value),placeholder:"e.g. 4:40",className:"mono"}))
  );

  if (type==="interval") return h("div",{style:{marginBottom:8}},
    h("div",null,h("label",{className:"lbl"},"Actual total distance (km)"),h("input",{type:"number",value:f.actualDistance||"",onChange:e=>s("actualDistance",e.target.value),placeholder:"0",className:"mono",style:{marginBottom:8}})),
    h("div",null,
      h("label",{className:"lbl"},"Split times / averages (write freely)"),
      h("textarea",{value:f.splitNotes||"",onChange:e=>s("splitNotes",e.target.value),rows:4,placeholder:"e.g. 8×800m: 3:12, 3:10, 3:11, 3:09, 3:11, 3:10, 3:08, 3:07\nAvg: 3:10"})
