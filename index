<script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
<script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
<script>
// Wait for React to be available
const {useState,useEffect,useCallback,useRef,createElement:h,Fragment} = React;

// ── Constants ─────────────────────────────────────────────────────────────────
const DAYS = ["Sun","Mon","Tue","Wed","Thu","Fri","Sat"];
const WT = {
  easy:    {label:"Easy run",  color:"#2ECC71",bg:"#E8F8F0",dark:"#1A7A43"},
  tempo:   {label:"Tempo",     color:"#BF00FF",bg:"#F5E6FF",dark:"#7700AA"},
  interval:{label:"Intervals", color:"#FF0090",bg:"#FFE6F4",dark:"#AA0060"},
  long:    {label:"Long run",  color:"#A78BFA",bg:"#F0EBFF",dark:"#6040C0"},
  race:    {label:"Race",      color:"#E05C5C",bg:"#FCEAEA",dark:"#902020"},
  strength:{label:"Strength",  color:"#F97316",bg:"#FEF0E6",dark:"#A04010"},
  recovery:{label:"Recovery",  color:"#06B6D4",bg:"#E0F7FA",dark:"#0E7490"},
  hills:   {label:"Hill reps", color:"#A0784A",bg:"#F5EDE0",dark:"#6B4E28"},
  fartlek: {label:"Fartlek",   color:"#7C3AED",bg:"#EDE9FE",dark:"#4C1D95"},
  rest:    {label:"Rest / Off",color:"#8A9BB0",bg:"#F0F3F7",dark:"#4A5568"},
};
const LVL = {
  serious:     {label:"Serious",     bg:"#F0EBFF",color:"#6040C0",border:"#A78BFA"},
  recreational:{label:"Recreational",bg:"#E6F3FF",color:"#1A5FA0",border:"#3B9EFF"},
};
const SS = {
  done:    {bg:"#E8F8F0",color:"#1A7A43",border:"#2ECC71",label:"✓ Done"},
  modified:{bg:"#FEF3E0",color:"#9A6610",border:"#F5A623",label:"~ Modified"},
  skipped: {bg:"#FCEAEA",color:"#902020",border:"#E05C5C",label:"✕ Skipped"},
};
const COACH_EMAIL = "amit@coach.amit1";

// ── Utils ─────────────────────────────────────────────────────────────────────
const DAYS_IDX = Object.fromEntries(DAYS.map((d,i)=>[d,i]));
const getWeekStart = (off=0) => {
  const d=new Date();
  const day=d.getDay(); // 0=Sun
  d.setDate(d.getDate()-day+off*7);
  d.setHours(0,0,0,0);
  return d;
};
const weekKey = (off=0) => {
  const d = new Date();
  // Subtract current day-of-week to get to Sunday, apply week offset
  d.setDate(d.getDate() - d.getDay() + (off * 7));
  // Use local date components to avoid UTC timezone shift
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, "0");
  const day = String(d.getDate()).padStart(2, "0");
  return `${y}-${m}-${day}`;
};
const weekLabel = (off=0) => {const s=getWeekStart(off),e=new Date(s);e.setDate(s.getDate()+6);return `${s.getDate()}/${s.getMonth()+1} – ${e.getDate()}/${e.getMonth()+1}`;};
const todayShort = () => DAYS[new Date().getDay()];
const initials = n => n.split(" ").map(w=>w[0]).join("").slice(0,2).toUpperCase();
const ccColor  = p => p===null?{bg:"#F0F3F7",color:"#8A9BB0"}:p>=80?{bg:"#E8F8F0",color:"#1A7A43"}:p>=50?{bg:"#FEF3E0",color:"#9A6610"}:{bg:"#FCEAEA",color:"#902020"};
const newPart  = (type="easy") => ({type,distance:"",pace:"",notes:"",_showPace:false});
const newSess  = () => ({parts:[newPart()]});
const newDay   = (rest=false,sessions=null) => ({restDay:rest,sessions:sessions||[newSess()]});
const sessTotalKm = s => (s.parts||[]).reduce((t,p)=>t+(parseFloat(p.distance)||0),0);
const dayTotalKm  = d => (d?.sessions||[]).reduce((t,s)=>t+sessTotalKm(s),0);
const dayIsRest   = d => !d||d.restDay||(d.sessions||[]).length===0;
const sessFirstType = s => s.parts&&s.parts.length>0?s.parts[0].type:"easy";

// Bulletproof plan normalization — handles any format Firebase might return
const normalizePart = p => {
  if(!p||typeof p!=="object") return newPart();
  // hillRows might be nested inside the array items or at the top level
  const hillRows = p.hillRows || null;
  return { 
    type:p.type||"easy", 
    distance:p.distance||"", 
    pace:p.pace||"", 
    notes:p.notes||"", 
    _showPace:!!(p.pace||p._showPace),
    ...(hillRows ? {hillRows: Array.isArray(hillRows) ? hillRows : Object.values(hillRows)} : {})
  };
};
const normalizeSess = s => {
  if(!s||typeof s!=="object") return newSess();
  // has parts array
  if(Array.isArray(s.parts)&&s.parts.length>0) return { parts:s.parts.map(normalizePart) };
  // old format with type directly on session
  if(s.type) return { parts:[normalizePart(s)] };
  return newSess();
};
const normalizeDay = d => {
  if(!d||typeof d!=="object") return newDay(true,[]);
  // explicit rest
  if(d.restDay===true||(Array.isArray(d.sessions)&&d.sessions.length===0&&d.restDay!==false)) return newDay(true,[]);
  // old format: type directly on day
  if(d.type==="rest") return newDay(true,[]);
  if(d.type) return newDay(false,[{parts:[normalizePart(d)]}]);
  // new format: has sessions array
  if(Array.isArray(d.sessions)) {
    if(d.sessions.length===0) return newDay(true,[]);
    return { restDay:false, sessions:d.sessions.map(normalizeSess) };
  }
  return newDay(true,[]);
};
const migratePlan = plan => {
  if(!plan||typeof plan!=="object") return {};
  const r={};
  DAYS.forEach(day=>{ r[day]=normalizeDay(plan[day]); });
  return r;
};

// Robustly get hillRows from a part in any storage format
const getHillRows = part => {
  if(!part) return [];
  const hr = part.hillRows;
  if(!hr) return [];
  if(Array.isArray(hr)) return hr;
  if(typeof hr==="object") return Object.values(hr);
  return [];
};
const hillRowsSummary = part => {
  const rows = getHillRows(part).filter(r=>parseFloat(r.reps)>0);
  if(!rows.length) return null;
  return rows.map(r=>{
    const sets=parseFloat(r.sets)||1, reps=parseFloat(r.reps)||0, dist=parseFloat(r.distM)||0;
    return (sets>1?sets+"×":"")+reps+"×"+dist+"m";
  }).join(" + ")+" · "+parseFloat(part.distance||0).toFixed(3)+" km";
};

const fb = () => window._firebase;

const dbGetPlan = async (athleteId, off=0) => {
  const {db, collection:col, getDocs} = fb();
  try {
    const weeksRef = col(db, `plans/${athleteId}/weeks`);
    const snap = await getDocs(weeksRef);
    if (snap.empty) return null;
    const docList = [];
    snap.forEach(d => docList.push({id:d.id, data:d.data()}));
    const wk = weekKey(off);
    // Try exact match first
    const exact = docList.find(d => d.id === wk);
    if (exact) return exact.data;
    // Try ±2 days to handle any timezone edge case
    for (let delta = -2; delta <= 2; delta++) {
      if (delta === 0) continue;
      const base = new Date(wk + "T12:00:00");
      base.setDate(base.getDate() + delta);
      const tryKey = `${base.getFullYear()}-${String(base.getMonth()+1).padStart(2,"0")}-${String(base.getDate()).padStart(2,"0")}`;
      const found = docList.find(d => d.id === tryKey);
      if (found) return found.data;
    }
    // Last resort: most recent document
    docList.sort((a,b) => b.id.localeCompare(a.id));
    return docList[0]?.data || null;
  } catch(e) {
    console.error("dbGetPlan error:", e);
    return null;
  }
};

const dbGet = async (path) => {
  const {db,doc,getDoc} = fb();
  const snap = await getDoc(doc(db,...path.split("/")));
  return snap.exists() ? snap.data() : null;
};
const dbSet = async (path, data) => {
  const {db,doc,setDoc} = fb();
  await setDoc(doc(db,...path.split("/")), data, {merge:true});
};
const dbDel = async (path) => {
  const {db,doc,deleteDoc} = fb();
  await deleteDoc(doc(db,...path.split("/")));
};
const dbList = async (col) => {
  const {db,collection,getDocs} = fb();
  const snap = await getDocs(collection(db,col));
  return snap.docs.map(d=>({id:d.id,...d.data()}));
};

// ── Small UI components ───────────────────────────────────────────────────────
const Avatar = ({name,level,size=38}) => {
  const c=LVL[level]||LVL.recreational;
  return h("div",{style:{width:size,height:size,borderRadius:"50%",flexShrink:0,background:c.bg,color:c.color,border:`1.5px solid ${c.border}`,display:"flex",alignItems:"center",justifyContent:"center",fontSize:size>40?15:12,fontWeight:700}},initials(name));
};
const StatCard = ({label,value,accent}) =>
  h("div",{className:"sc"},h("div",{className:"sl"},label),h("div",{className:"sv",style:{color:accent||"#0F1117"}},value));
const Toast = ({msg,ok}) =>
  h("div",{className:"toast",style:{background:ok?"#E8F8F0":"#FCEAEA",color:ok?"#1A7A43":"#902020",border:`0.5px solid ${ok?"#2ECC71":"#E05C5C"}`}},msg);
const Spinner = () => h("div",{style:{display:"flex",alignItems:"center",justifyContent:"center",padding:"3rem"}},h("div",{className:"spin"}));
const Modal = ({title,onClose,children,wide}) =>
  h("div",{className:"mo",onClick:e=>{if(e.target===e.currentTarget)onClose();}},
    h("div",{className:"mb",style:{maxWidth:wide?720:460}},
      h("div",{style:{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:20}},
        h("div",{style:{fontSize:17,fontWeight:700}},title),
        h("button",{onClick:onClose,style:{border:"none",background:"none",fontSize:24,cursor:"pointer",color:"#8A9BB0",lineHeight:1}},"×")
      ),children
    )
  );

// WeekStrip
const WeekStrip = ({plan={},reports={},compact=false}) =>
  h("div",{style:{display:"flex",gap:3,marginTop:compact?8:12}},
    DAYS.map(day=>{
      const d=plan[day],r=reports[day],isRest=dayIsRest(d),sessions=d?.sessions||[];
      return h("div",{key:day,style:{flex:1,textAlign:"center"}},
        !compact&&h("div",{style:{fontSize:9,color:"#8A9BB0",marginBottom:3,fontWeight:600,letterSpacing:"0.06em",textTransform:"uppercase"}},day),
        isRest
          ? h("div",{style:{height:compact?20:28,borderRadius:3,background:"#F0F3F7",border:"1.5px solid #CBD5E0",opacity:.35}})
          : h("div",{style:{display:"flex",flexDirection:"column",gap:2}},
              sessions.map((sess,si)=>{
                const wt=WT[sessFirstType(sess)]||WT.easy;
                const rep=r?.sessions?.[si];
                const done=rep?.status==="done",mod=rep?.status==="modified",skip=rep?.status==="skipped";
                const bh=sessions.length>1?Math.max(12,(compact?20:28)/sessions.length):(compact?20:28);
                return h("div",{key:si,style:{height:bh,borderRadius:3,background:skip?"#F0F3F7":wt.bg,border:`1.5px solid ${(done||mod)?wt.color:skip?"#CBD5E0":wt.color+"55"}`,display:"flex",alignItems:"center",justifyContent:"center"}},
                  done&&h("span",{style:{fontSize:9,color:wt.dark,fontWeight:700}},"✓"),
                  skip&&h("span",{style:{fontSize:9,color:"#8A9BB0"}},"✕"),
                  mod&&h("span",{style:{fontSize:9,color:wt.dark}},"~"),
                  !rep&&sessTotalKm(sess)>0&&h("span",{style:{fontSize:7,fontWeight:700,color:wt.dark,fontFamily:"monospace"}},sessTotalKm(sess).toFixed(0)+"k")
                );
              })
            )
      );
    })
  );

// ── Part Editor ───────────────────────────────────────────────────────────────
const HillPlanRows = ({part, onChange}) => {
  const rows = getHillRows(part).length > 0 ? getHillRows(part) : [{sets:"",reps:"",distM:""}];
  const update = (i,k,v) => {
    const nr=[...rows]; nr[i]={...nr[i],[k]:v};
    const totalKm=nr.reduce((t,r)=>{
      const sets=parseFloat(r.sets)||1, reps=parseFloat(r.reps)||0, dist=parseFloat(r.distM)||0;
      return t+(sets*reps*dist/1000);
    },0);
    onChange({...part, hillRows:nr, distance:totalKm.toFixed(3)});
  };
  const addRow = () => onChange({...part, hillRows:[...rows,{sets:"",reps:"",distM:""}]});
  const removeRow = i => {
    const nr=rows.filter((_,idx)=>idx!==i);
    const totalKm=nr.reduce((t,r)=>{
      const sets=parseFloat(r.sets)||1, reps=parseFloat(r.reps)||0, dist=parseFloat(r.distM)||0;
      return t+(sets*reps*dist/1000);
    },0);
    onChange({...part, hillRows:nr, distance:totalKm.toFixed(3)});
  };
  const totalKm=rows.reduce((t,r)=>{
    const sets=parseFloat(r.sets)||1, reps=parseFloat(r.reps)||0, dist=parseFloat(r.distM)||0;
    return t+(sets*reps*dist/1000);
  },0);
  return h("div",{style:{marginTop:6}},
    h("div",{style:{display:"grid",gridTemplateColumns:"70px 70px 70px 1fr 20px",gap:5,marginBottom:4,alignItems:"center"}},
      h("div",{style:{fontSize:10,color:"#8A9BB0",fontWeight:600}},"Sets"),
      h("div",{style:{fontSize:10,color:"#8A9BB0",fontWeight:600}},"Reps"),
      h("div",{style:{fontSize:10,color:"#8A9BB0",fontWeight:600}},"Dist (m)"),
      h("div",{style:{fontSize:10,color:"#8A9BB0",fontWeight:600}},"= km"),
      h("div")
    ),
    rows.map((row,i)=>{
      const sets=parseFloat(row.sets)||1, reps=parseFloat(row.reps)||0, dist=parseFloat(row.distM)||0;
      const rowKm=(sets*reps*dist/1000);
      return h("div",{key:i,style:{display:"grid",gridTemplateColumns:"70px 70px 70px 1fr 20px",gap:5,marginBottom:5,alignItems:"center"}},
        h("input",{type:"number",value:row.sets,onChange:e=>update(i,"sets",e.target.value),placeholder:"2",style:{padding:"4px 6px",fontSize:12,fontFamily:"'DM Mono',monospace"}}),
        h("input",{type:"number",value:row.reps,onChange:e=>update(i,"reps",e.target.value),placeholder:"4",style:{padding:"4px 6px",fontSize:12,fontFamily:"'DM Mono',monospace"}}),
        h("input",{type:"number",value:row.distM,onChange:e=>update(i,"distM",e.target.value),placeholder:"120",style:{padding:"4px 6px",fontSize:12,fontFamily:"'DM Mono',monospace"}}),
        h("div",{style:{fontSize:11,color:"#0F1117",fontFamily:"monospace",paddingLeft:4}}, rowKm>0?rowKm.toFixed(3)+" km":"—"),
        rows.length>1?h("button",{onClick:()=>removeRow(i),style:{border:"none",background:"none",cursor:"pointer",color:"#E05C5C",fontSize:14,lineHeight:1,padding:0}},"×"):h("div")
      );
    }),
    h("div",{style:{display:"flex",alignItems:"center",justifyContent:"space-between",marginTop:4}},
      h("button",{onClick:addRow,className:"btn btns",style:{fontSize:11}},"+ Add row"),
      totalKm>0&&h("span",{style:{fontSize:11,fontWeight:700,color:"#0F1117",fontFamily:"monospace"}},"Total: "+totalKm.toFixed(3)+" km")
    )
  );
};

const PartEditor = ({part,onChange,onRemove,index,total}) => {
  const wt=WT[part.type]||WT.easy;
  const isHills = part.type==="hills";
  return h("div",{style:{display:"flex",alignItems:"flex-start",gap:6,marginBottom:6,padding:"8px 10px",borderRadius:6,background:"#fff",border:`0.5px solid ${wt.color}44`,borderLeft:`3px solid ${wt.color}`}},
    h("div",{style:{flex:1}},
      h("div",{className:"row",style:{marginBottom:5}},
        h("span",{style:{fontSize:10,fontWeight:700,color:"#8A9BB0",minWidth:50}},"Part "+(index+1)),
        h("select",{value:part.type,onChange:e=>onChange({...part,type:e.target.value,hillRows:undefined,distance:""}),style:{width:"auto",fontSize:12,fontWeight:600,color:wt.dark,padding:"3px 6px",border:"0.5px solid #CBD5E0",borderRadius:4}},
          Object.entries(WT).filter(([k])=>k!=="rest").map(([k,v])=>h("option",{key:k,value:k},v.label))
        ),
        !isHills&&h(Fragment,null,
          h("span",{style:{fontSize:11,color:"#8A9BB0"}},"Total KMs"),
          h("input",{value:part.distance,onChange:e=>onChange({...part,distance:e.target.value}),placeholder:"0",style:{width:48,fontSize:12,padding:"3px 6px",fontFamily:"'DM Mono',monospace",border:"0.5px solid #CBD5E0",borderRadius:4}}),
          part._showPace
            ? h(Fragment,null,
                h("span",{style:{fontSize:11,color:"#8A9BB0"}},"@ "),
