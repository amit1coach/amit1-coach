const firebaseConfig = {
  apiKey: "AIzaSyDJ4eH7n4xZH6UkGmvVNDu8W9npnoklsEs",
  authDomain: "amit1-9b45d.firebaseapp.com",
  projectId: "amit1-9b45d",
  storageBucket: "amit1-9b45d.firebasestorage.app",
