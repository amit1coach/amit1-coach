const SeasonCalendar = ({onClose, isCoach}) => {
  const [events, setEvents] = useState([]);
  const [loading, setLoading] = useState(true);
  const [addingEvent, setAddingEvent] = useState(null);
  const [editingEvent, setEditingEvent] = useState(null);
  const [form, setForm] = useState({name:"", type:"race", dateStart:"", dateEnd:"", location:"", mandatory:true, notes:""});
  const [toast, setToast] = useState(null);
  const showToast = useCallback((msg,ok=true)=>{ setToast({msg,ok}); setTimeout(()=>setToast(null),2000); },[]);

  useEffect(()=>{
    dbList("seasonEvents").then(evs=>{ setEvents(evs); setLoading(false); });
  },[]);

  const saveEvent = async () => {
    if (!form.name.trim() || !form.dateStart) return;
    const id = editingEvent?.id || "ev"+Date.now();
    const dateEnd = form.dateEnd && form.dateEnd >= form.dateStart ? form.dateEnd : form.dateStart;
    const ev = { id, ...form, dateEnd };
    await dbSet(`seasonEvents/${id}`, ev);
    setEvents(prev => editingEvent ? prev.map(e=>e.id===id?ev:e) : [...prev, ev]);
    setAddingEvent(null); setEditingEvent(null);
    setForm({name:"", type:"race", dateStart:"", dateEnd:"", location:"", mandatory:true, notes:""});
    showToast("Event saved");
  };

  const deleteEvent = async (id) => {
    if (!window.confirm("Delete this event?")) return;
    await dbDel(`seasonEvents/${id}`);
    setEvents(prev => prev.filter(e=>e.id!==id));
    showToast("Event deleted");
  };

  const openAdd = (dateStr) => {
    if (!isCoach) return;
    setForm({name:"", type:"race", dateStart:dateStr, dateEnd:dateStr, location:"", mandatory:true, notes:""});
    setEditingEvent(null);
    setAddingEvent(dateStr);
  };

  const openEdit = (ev) => {
    if (!isCoach) return;
    setForm({name:ev.name, type:ev.type, dateStart:ev.dateStart||ev.date||"", dateEnd:ev.dateEnd||ev.dateStart||ev.date||"", location:ev.location||"", mandatory:ev.mandatory!==false, notes:ev.notes||""});
    setEditingEvent(ev);
    setAddingEvent(ev.dateStart||ev.date);
  };

  // Check if an event spans a given date
  const eventsOnDate = (dateStr) => events.filter(ev => {
    const start = ev.dateStart||ev.date||"";
    const end = ev.dateEnd||start;
    return dateStr >= start && dateStr <= end;
  });

  const isEventStart = (ev, dateStr) => (ev.dateStart||ev.date) === dateStr;
  const isEventEnd   = (ev, dateStr) => (ev.dateEnd||ev.dateStart||ev.date) === dateStr;
  const isMultiDay   = (ev) => (ev.dateEnd||ev.dateStart||ev.date) !== (ev.dateStart||ev.date);

  const now = new Date();
  const months = [];
  for (let mi = 0; mi < 6; mi++) {
    const d = new Date(now.getFullYear(), now.getMonth() + mi, 1);
    months.push({ year: d.getFullYear(), month: d.getMonth() });
  }

  const todayStr = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,"0")}-${String(now.getDate()).padStart(2,"0")}`;

  const renderMonth = ({year, month}) => {
    const firstDay = new Date(year, month, 1).getDay();
    const daysInMonth = new Date(year, month+1, 0).getDate();
    const cells = [];
    for (let i=0; i<firstDay; i++) cells.push(h("div",{key:"e"+i}));
    for (let day=1; day<=daysInMonth; day++) {
      const dateStr = `${year}-${String(month+1).padStart(2,"0")}-${String(day).padStart(2,"0")}`;
      const dayEvents = eventsOnDate(dateStr);
      const isToday = dateStr === todayStr;
      cells.push(
        h("div",{key:day,
          onClick:()=>openAdd(dateStr),
          style:{ minHeight:56, padding:"4px 5px", borderRadius:6, cursor:isCoach?"pointer":"default",
            background:isToday?"#FEF3E0":"#fff",
            border:isToday?"1.5px solid #F5A623":"0.5px solid #F0F3F7" }},
          h("div",{style:{fontSize:11, fontWeight:isToday?700:400, color:isToday?"#F5A623":"#8A9BB0", marginBottom:2}},day),
          dayEvents.map(ev=>{
            const et=EVENT_TYPES[ev.type]||EVENT_TYPES.other;
            const multi=isMultiDay(ev);
            const isStart=isEventStart(ev,dateStr);
            const isEnd=isEventEnd(ev,dateStr);
            const borderRadius = !multi?"3px":isStart?"3px 0 0 3px":isEnd?"0 3px 3px 0":"0";
            return h("div",{key:ev.id,
              onClick:e=>{ e.stopPropagation(); openEdit(ev); },
              style:{ fontSize:9, fontWeight:600, padding:"2px 4px", marginBottom:2,
                background:et.bg, color:et.color, cursor:isCoach?"pointer":"default",
                borderTop:`1px solid ${et.color}66`, borderBottom:`1px solid ${et.color}66`,
                borderLeft:isStart||!multi?`2px solid ${et.color}`:"none",
                borderRight:isEnd||!multi?`1px solid ${et.color}44`:"none",
                borderRadius, lineHeight:1.3,
                whiteSpace:"nowrap", overflow:"hidden", textOverflow:"ellipsis"
              }},
              isStart ? et.emoji+" "+ev.name+(ev.mandatory===false?" (opt)":"") : ""
            );
          })
        )
      );
    }
    return h("div",{key:`${year}-${month}`, style:{marginBottom:28}},
      h("div",{style:{fontSize:15, fontWeight:700, color:"#0F1117", marginBottom:10, paddingBottom:6, borderBottom:"0.5px solid #E2E8F0"}},
        MONTH_NAMES[month]+" "+year),
      h("div",{style:{display:"grid", gridTemplateColumns:"repeat(7,1fr)", gap:3, marginBottom:4}},
        DAYS.map(d=>h("div",{key:d,style:{fontSize:9,fontWeight:700,color:"#8A9BB0",textAlign:"center",textTransform:"uppercase",letterSpacing:"0.06em"}},d))
      ),
      h("div",{style:{display:"grid", gridTemplateColumns:"repeat(7,1fr)", gap:3}}, cells)
    );
  };

  return h("div",{style:{maxWidth:760, margin:"0 auto", padding:"1.5rem 1rem"}},
    toast&&h(Toast,{msg:toast.msg,ok:toast.ok}),
    h("div",{style:{display:"flex", alignItems:"center", justifyContent:"space-between", marginBottom:"1.5rem"}},
      h("div",null,
        h("div",{style:{fontSize:10,fontWeight:700,color:"#F5A623",letterSpacing:"0.14em",textTransform:"uppercase",marginBottom:4}},"Amit 1"),
        h("h2",{style:{fontSize:22,fontWeight:700,margin:0}},"Season Calendar"),
        h("div",{style:{fontSize:13,color:"#8A9BB0",marginTop:2}},isCoach?"Click any day to add an event":"Team race & event schedule")
      ),
      h("button",{className:"btn",onClick:onClose},"← Back")
    ),
    h("div",{style:{display:"flex",gap:8,flexWrap:"wrap",marginBottom:20}},
      Object.entries(EVENT_TYPES).map(([k,v])=>
        h("span",{key:k,style:{fontSize:11,fontWeight:600,padding:"3px 10px",borderRadius:4,background:v.bg,color:v.color,border:`0.5px solid ${v.color}44`}},
          v.emoji+" "+v.label)
      )
    ),
    loading ? h(Spinner) : months.map(renderMonth),
    addingEvent&&h("div",{className:"mo",onClick:e=>{if(e.target===e.currentTarget){setAddingEvent(null);setEditingEvent(null);}}},
      h("div",{className:"mb",style:{maxWidth:440}},
        h("div",{style:{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:20}},
          h("div",{style:{fontSize:17,fontWeight:700}},(editingEvent?"Edit":"Add")+" event"),
          h("button",{onClick:()=>{setAddingEvent(null);setEditingEvent(null);},style:{border:"none",background:"none",fontSize:24,cursor:"pointer",color:"#8A9BB0",lineHeight:1}},"×")
        ),
        h("div",{style:{marginBottom:12}},
          h("label",{className:"lbl"},"Event name"),
          h("input",{value:form.name,onChange:e=>setForm(f=>({...f,name:e.target.value})),placeholder:"e.g. Training Camp Tiberias"})
        ),
        h("div",{style:{display:"grid",gridTemplateColumns:"1fr 1fr",gap:12,marginBottom:12}},
          h("div",null,
            h("label",{className:"lbl"},"Start date"),
            h("input",{type:"date",value:form.dateStart,onChange:e=>setForm(f=>({...f,dateStart:e.target.value}))})
          ),
          h("div",null,
            h("label",{className:"lbl"},"End date"),
            h("input",{type:"date",value:form.dateEnd,onChange:e=>setForm(f=>({...f,dateEnd:e.target.value})),min:form.dateStart})
          ),
          h("div",null,
            h("label",{className:"lbl"},"Type"),
            h("select",{value:form.type,onChange:e=>setForm(f=>({...f,type:e.target.value}))},
              Object.entries(EVENT_TYPES).map(([k,v])=>h("option",{key:k,value:k},v.emoji+" "+v.label))
            )
          ),
          h("div",null,
            h("label",{className:"lbl"},"Participation"),
            h("select",{value:form.mandatory?"mandatory":"optional",onChange:e=>setForm(f=>({...f,mandatory:e.target.value==="mandatory"}))},
              h("option",{value:"mandatory"},"Mandatory"),
              h("option",{value:"optional"},"Optional")
            )
          )
        ),
        h("div",{style:{marginBottom:12}},
          h("label",{className:"lbl"},"Location"),
          h("input",{value:form.location,onChange:e=>setForm(f=>({...f,location:e.target.value})),placeholder:"e.g. Tiberias"})
        ),
        h("div",{style:{marginBottom:20}},
          h("label",{className:"lbl"},"Notes"),
          h("textarea",{value:form.notes,onChange:e=>setForm(f=>({...f,notes:e.target.value})),rows:2,placeholder:"Any additional info…"})
        ),
        h("div",{style:{display:"flex",gap:8,justifyContent:"space-between"}},
          editingEvent
            ? h("button",{className:"btnd",onClick:()=>deleteEvent(editingEvent.id)},"Delete event")
            : h("div"),
          h("div",{style:{display:"flex",gap:8}},
            h("button",{className:"btn",onClick:()=>{setAddingEvent(null);setEditingEvent(null);}},"Cancel"),
            h("button",{className:"btnp",onClick:saveEvent},"Save event")
          )
        )
      )
    )
  );
};

// ── Coach Dashboard ───────────────────────────────────────────────────────────
const CoachDashboard = ({user,onSignOut}) => {
  const [athletes,setAthletes]=useState([]);
  const [groups,setGroups]=useState([]);
  const [selectedAthlete,setSelectedAthlete]=useState(null);
  const [addingAthlete,setAddingAthlete]=useState(false);
  const [showGroups,setShowGroups]=useState(false);
  const [showCalendar,setShowCalendar]=useState(false);
  const [search,setSearch]=useState("");
  const [filter,setFilter]=useState("all");
  const [loading,setLoading]=useState(true);
  const [toast,setToast]=useState(null);
  const [weeklyReports,setWeeklyReports]=useState({});
  const showToast=useCallback((msg,ok=true)=>{setToast({msg,ok});setTimeout(()=>setToast(null),2500);},[]);

  const loadData=async()=>{
    const [aths,grps]=await Promise.all([dbList("athletes"),dbList("groups")]);
    setAthletes(aths);
    setGroups(grps);
    // load this week's reports for all athletes for compliance strip
    const wk=weekKey(0);
    const repPromises=aths.map(a=>dbGet(`reports/${a.id}/weeks/${wk}`).then(r=>({id:a.id,r})));
    const reps=await Promise.all(repPromises);
    const repMap={};
    reps.forEach(({id,r})=>{repMap[id]=r||{};});
    setWeeklyReports(repMap);
    setLoading(false);
  };

  useEffect(()=>{loadData();},[]);

  const addAthlete=async(f)=>{
    try{
      const {auth,createUserWithEmailAndPassword}=fb();
      const cred=await createUserWithEmailAndPassword(auth,f.email,f.password);
      const uid=cred.user.uid;
      const data={name:f.name,level:f.level||"recreational",age:f.age||"",pb5k:f.pb5k||"",pb10k:f.pb10k||"",pbHalf:f.pbHalf||"",pbMarathon:f.pbMarathon||"",events:f.events||"",notes:f.notes||"",groupId:f.groupId||"",role:"athlete"};
      await dbSet(`athletes/${uid}`,data);
      setAthletes(prev=>[...prev,{id:uid,...data}]);
      setAddingAthlete(false);
      showToast("Athlete added & account created");
      // sign coach back in — Firebase auto-signs in new user, so reload
      window.location.reload();
    }catch(e){showToast("Error: "+e.message,false);}
  };

  const updateAthlete=async(updated)=>{
    setAthletes(prev=>prev.map(a=>a.id===updated.id?updated:a));
  };

  const deleteAthlete=async(id)=>{
    await dbDel(`athletes/${id}`);
    setAthletes(prev=>prev.filter(a=>a.id!==id));
    showToast("Athlete removed");
  };

  const addGroup=async(name)=>{
    const id="g"+Date.now();
    await dbSet(`groups/${id}`,{name,id});
    setGroups(prev=>[...prev,{id,name}]);
    showToast("Group created");
  };

  const deleteGroup=async(id)=>{
    if(!window.confirm("Delete this group?"))return;
    await dbDel(`groups/${id}`);
    setGroups(prev=>prev.filter(g=>g.id!==id));
    showToast("Group deleted");
  };

  const wk0=weekKey(0),today=todayShort();
  const filtered=athletes.filter(a=>a.name.toLowerCase().includes(search.toLowerCase())&&(filter==="all"||a.level===filter));
  const serious=filtered.filter(a=>a.level==="serious");
  const recreational=filtered.filter(a=>a.level==="recreational");

  const getComp=(ath)=>{
    const reps=weeklyReports[ath.id]||{};
    // we don't have plans cached here — just show report count
    const reported=DAYS.filter(d=>reps[d]?.sessions?.length>0).length;
    return reported>0?reported:null;
  };

  if(selectedAthlete)return h(AthleteDetail,{athlete:selectedAthlete,groups,onBack:()=>setSelectedAthlete(null),onUpdate:updateAthlete,coachId:user.uid});
  if(showCalendar)return h(SeasonCalendar,{onClose:()=>setShowCalendar(false),isCoach:true});

  return h("div",{style:{maxWidth:780,margin:"0 auto",padding:"1.5rem 1rem"}},
    toast&&h(Toast,{msg:toast.msg,ok:toast.ok}),
    h("div",{style:{display:"flex",alignItems:"flex-end",justifyContent:"space-between",marginBottom:"1.75rem"}},
      h("div",null,
        h("div",{style:{fontSize:10,fontWeight:700,color:"#F5A623",letterSpacing:"0.14em",textTransform:"uppercase",marginBottom:4}},"Amit 1"),
        h("h1",{style:{fontSize:26,fontWeight:700,margin:0,letterSpacing:"-0.02em"}},"Running Coach"),
        h("div",{style:{fontSize:13,color:"#8A9BB0",marginTop:3}},weekLabel(0)+" · "+athletes.length+" athletes")
      ),
      h("div",{style:{display:"flex",gap:8,flexWrap:"wrap",justifyContent:"flex-end"}},
        h("button",{className:"btn btns",onClick:()=>setShowCalendar(true)},"📅 Season"),
        h("button",{className:"btn btns",onClick:()=>setShowGroups(true)},"👥 Groups"),
        h("button",{className:"btnp",onClick:()=>setAddingAthlete(true)},"+  Add athlete"),
        h("button",{className:"btn btns",onClick:onSignOut},"Sign out")
      )
    ),
    h("div",{style:{display:"flex",gap:10,marginBottom:"1.5rem"},className:"strow"},
      h(StatCard,{label:"Total athletes",value:athletes.length}),
      h(StatCard,{label:"Serious",value:athletes.filter(a=>a.level==="serious").length,accent:"#6040C0"}),
      h(StatCard,{label:"Groups",value:groups.length,accent:"#F5A623"}),
      h(StatCard,{label:"Today",value:today})
    ),
    h("div",{style:{display:"flex",gap:8,marginBottom:"1.25rem"}},
      h("input",{value:search,onChange:e=>setSearch(e.target.value),placeholder:"Search athletes…",style:{flex:1}}),
      ["all","serious","recreational"].map(f=>h("button",{key:f,onClick:()=>setFilter(f),style:{border:filter===f?"none":"0.5px solid #CBD5E0",background:filter===f?"#F5A623":"#fff",color:filter===f?"#fff":"#4A5568",borderRadius:6,padding:"8px 14px",fontSize:13,fontWeight:500,cursor:"pointer"}},f==="all"?"All":f==="serious"?"Serious":"Recreational"))
    ),
    loading&&h(Spinner),
    addingAthlete&&h(Modal,{title:"Add new athlete",onClose:()=>setAddingAthlete(false),wide:true},h(AthleteForm,{groups,onCancel:()=>setAddingAthlete(false),onSave:addAthlete})),
    showGroups&&h(GroupsManager,{groups,athletes,onAddGroup:addGroup,onDeleteGroup:deleteGroup,onSaveGroupPlan:()=>{},onClose:()=>setShowGroups(false)}),
    !loading&&[{title:"Serious athletes",list:serious},{title:"Recreational runners",list:recreational}].map(group=>
      group.list.length>0&&h("div",{key:group.title,style:{marginBottom:"1.75rem"}},
        h("div",{className:"stit"},group.title+" · "+group.list.length),
        group.list.map(ath=>{
          const reps=weeklyReports[ath.id]||{};
          const reported=DAYS.filter(d=>reps[d]?.sessions?.length>0).length;
          const grp=groups.find(g=>g.id===ath.groupId);
          return h("div",{key:ath.id,className:"card",style:{marginBottom:8},onClick:()=>setSelectedAthlete(ath)},
            h("div",{style:{display:"flex",alignItems:"center",gap:12}},
              h(Avatar,{name:ath.name,level:ath.level}),
              h("div",{style:{flex:1,minWidth:0}},
                h("div",{style:{display:"flex",alignItems:"center",gap:8,marginBottom:2,flexWrap:"wrap"}},
                  h("span",{style:{fontWeight:700,fontSize:15}},ath.name),
                  h("span",{style:{fontSize:11,color:"#8A9BB0"}},"Age "+ath.age),
                  ath.pb5k&&h("span",{className:"mono",style:{fontSize:11,color:"#4A5568"}},"5K "+ath.pb5k),
                  grp&&h("span",{style:{fontSize:10,padding:"1px 6px",borderRadius:3,background:"#FEF3E0",color:"#9A6610",fontWeight:600}},"📋 "+grp.name)
                ),
                h("div",{style:{fontSize:12,color:"#8A9BB0"}},reported>0?"This week: "+reported+" day"+(reported!==1?"s":"")+" reported":"No reports this week")
              ),
              h("div",{style:{display:"flex",alignItems:"center",gap:8,flexShrink:0}},
                reported>0&&h("span",{style:{fontSize:12,fontWeight:700,padding:"3px 10px",borderRadius:5,background:"#E8F8F0",color:"#1A7A43"}},reported+"d"),
                h("button",{onClick:e=>{e.stopPropagation();if(window.confirm("Remove "+ath.name+"?"))deleteAthlete(ath.id);},style:{border:"0.5px solid #E05C5C",background:"#FFF0F0",cursor:"pointer",color:"#E05C5C",fontSize:13,fontWeight:600,padding:"3px 9px",borderRadius:5}},"✕")
              )
            )
          );
        })
      )
    ),
    !loading&&filtered.length===0&&h("div",{style:{textAlign:"center",padding:"4rem 2rem",color:"#8A9BB0"}},
      h("div",{style:{fontSize:40,marginBottom:12}},"🏃"),
      h("div",{style:{fontSize:16,fontWeight:700,marginBottom:6,color:"#0F1117"}},"No athletes yet"),
      h("div",{style:{fontSize:14}},"Add your first athlete using the button above.")
    )
  );
};

// ── Login Screen ──────────────────────────────────────────────────────────────
const LoginScreen = ({onLogin}) => {
  const [email,setEmail]=useState("");
  const [password,setPassword]=useState("");
  const [error,setError]=useState("");
  const [loading,setLoading]=useState(false);
  const [resetSent,setResetSent]=useState(false);

  const login=async()=>{
    if(!email||!password){setError("Please enter email and password.");return;}
    setLoading(true);setError("");
    try{
      const {auth,signInWithEmailAndPassword}=fb();
      await signInWithEmailAndPassword(auth,email,password);
    }catch(e){
      setError("Incorrect email or password. Please try again.");
      setLoading(false);
    }
  };

  const resetPassword=async()=>{
    if(!email){setError("Enter your email above first.");return;}
    try{
      const {auth,sendPasswordResetEmail}=fb();
      await sendPasswordResetEmail(auth,email);
      setResetSent(true);setError("");
    }catch(e){setError("Could not send reset email.");}
  };

  return h("div",{style:{minHeight:"100vh",display:"flex",alignItems:"center",justifyContent:"center",padding:"1rem",background:"#F4F6F9"}},
    h("div",{className:"login-box"},
      h("div",{style:{textAlign:"center",marginBottom:28}},
        h("div",{style:{fontSize:11,fontWeight:700,color:"#F5A623",letterSpacing:"0.14em",textTransform:"uppercase",marginBottom:6}},"Amit 1"),
        h("div",{style:{fontSize:24,fontWeight:700,marginBottom:4}},"Running Coach"),
        h("div",{style:{fontSize:13,color:"#8A9BB0"}},"Sign in to continue")
      ),
      h("div",{style:{marginBottom:12}},h("label",{className:"lbl"},"Email"),h("input",{type:"email",value:email,onChange:e=>setEmail(e.target.value),placeholder:"your@email.com",onKeyDown:e=>e.key==="Enter"&&login()})),
      h("div",{style:{marginBottom:20}},h("label",{className:"lbl"},"Password"),h("input",{type:"password",value:password,onChange:e=>setPassword(e.target.value),placeholder:"••••••••",onKeyDown:e=>e.key==="Enter"&&login()})),
      error&&h("div",{style:{fontSize:13,color:"#902020",background:"#FCEAEA",padding:"8px 12px",borderRadius:6,marginBottom:12}},error),
      resetSent&&h("div",{style:{fontSize:13,color:"#1A7A43",background:"#E8F8F0",padding:"8px 12px",borderRadius:6,marginBottom:12}},"Password reset email sent. Check your inbox."),
      h("button",{className:"btnp",onClick:login,disabled:loading,style:{width:"100%",justifyContent:"center",marginBottom:10}},loading?h("div",{className:"spin"}):"Sign in"),
      h("button",{onClick:resetPassword,style:{border:"none",background:"none",color:"#8A9BB0",fontSize:12,cursor:"pointer",width:"100%",textAlign:"center"}},"Forgot password?")
    )
  );
};

// ── Root App ──────────────────────────────────────────────────────────────────
function App() {
  const [fbReady,setFbReady]=useState(!!window._firebase);
  const [user,setUser]=useState(null);
  const [authLoading,setAuthLoading]=useState(true);
  const [role,setRole]=useState(null); // "coach" | "athlete"

  useEffect(()=>{
    const init=()=>{
      setFbReady(true);
      const {auth,onAuthStateChanged}=fb();
      onAuthStateChanged(auth,async(u)=>{
        if(u){
          // check if coach
          if(u.email===COACH_EMAIL){setRole("coach");setUser(u);}
          else{
            const profile=await dbGet(`athletes/${u.uid}`);
            if(profile){setRole("athlete");setUser(u);}
            else{setRole("coach");setUser(u);}
          }
        }else{setUser(null);setRole(null);}
        setAuthLoading(false);
      });
    };
    if(window._firebase)init();
    else window.addEventListener("firebase-ready",init,{once:true});
  },[]);

  const signOut=()=>{const {auth,signOut:so}=fb();so(auth);};

  if(!fbReady||authLoading)return h("div",{style:{minHeight:"100vh",display:"flex",alignItems:"center",justifyContent:"center"}},h("div",{className:"spin"}));
  if(!user)return h(LoginScreen);
  if(role==="athlete")return h(AthleteHome,{user,onSignOut:signOut});
  return h(CoachDashboard,{user,onSignOut:signOut});
}

ReactDOM.createRoot(document.getElementById("root")).render(h(App,null));
</script>
