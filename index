// Extract a readable summary from a session report (new or old format)
const repSummary = (rep, parts) => {
  if (!rep) return null;
  const lines = [];
  // New format: partReps with typeData
  if (rep.partReps && rep.partReps.length > 0) {
    rep.partReps.forEach((pr, i) => {
      const part = parts?.[i];
      const td = pr.typeData || {};
      const type = part?.type || "easy";
      const wt = WT[type] || WT.easy;
      const dist = parseFloat(pr.actualDistance || td.actualDistance) || 0;
      let detail = "";
      if (type==="easy"||type==="recovery") detail = td.actualPace ? `@ ${td.actualPace}/km` : "";
      else if (type==="tempo") detail = td.tempoPace ? `tempo @ ${td.tempoPace}/km` : "";
      else if (type==="interval") detail = td.splitNotes ? `splits: ${td.splitNotes.split("\n")[0].slice(0,40)}` : "";
      else if (type==="long") {
        if (td.avgPace) detail += `avg ${td.avgPace}/km`;
        if (td.part1Pace) detail += ` · base ${td.part1Pace}/km`;
        if (td.fasterPace) detail += ` · faster ${td.fasterPace}/km`;
      }
      else if (type==="fartlek") {
        if (td.fasterPace) detail = `faster ${td.fasterPace}/km · transition ${td.transitionPace||"–"}/km`;
      }
      else if (type==="hills") {
        const hillRows = td.hillRows||[];
        if (hillRows.length>0) {
          const rowDetails = hillRows.map(r=>{
            const sets=parseFloat(r.sets)||1, reps=parseFloat(r.reps)||0, dist=parseFloat(r.distM)||0;
            const km=(sets*reps*dist/1000);
            return `${sets}×${reps}×${dist}m = ${km.toFixed(3)}km`;
          }).join(" | ");
          detail = rowDetails;
        }
        if (td.actualDistance) detail += ` → total ${parseFloat(td.actualDistance).toFixed(3)}km`;
      }
      else if (type==="strength") detail = td.duration ? `${td.duration} min` : "";
      else if (type==="race") detail = td.finishTime ? `finish ${td.finishTime}` : "";
      lines.push({ label: wt.label, dist, detail, color: wt.dark });
    });
  } else {
    // Old format fallback
    const dist = parseFloat(rep.actualDistance) || 0;
    const pace = rep.actualPace ? `@ ${rep.actualPace}/km` : "";
    lines.push({ label: "", dist, detail: pace, color: "#4A5568" });
  }
  return lines;
};

