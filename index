// ── Plan Editor ───────────────────────────────────────────────────────────────
const PlanEditor = ({plan,onSave,onCancel,groupName}) => {
  const [local,setLocal]=useState(()=>{
    const p={};
    DAYS.forEach(day=>{
      const d=plan[day];
      if(!d){p[day]=newDay(true,[]);return;}
      p[day]={...d,sessions:(d.sessions||[]).map(s=>({...s,parts:(s.parts||[]).map(pp=>({...pp}))}))};
    });
    return p;
  });
  const toggleRest=day=>setLocal(p=>({...p,[day]:{...p[day],restDay:!p[day].restDay,sessions:p[day].restDay?[newSess()]:[]}}));
  const addSess   =day=>setLocal(p=>({...p,[day]:{...p[day],sessions:[...p[day].sessions,newSess()]}}));
  const updSess   =(day,i,s)=>setLocal(p=>{const ss=[...p[day].sessions];ss[i]=s;return{...p,[day]:{...p[day],sessions:ss}};});
  const remSess   =(day,i)=>setLocal(p=>{const ss=p[day].sessions.filter((_,idx)=>idx!==i);return{...p,[day]:{...p[day],sessions:ss}};});
  const totalKm=DAYS.reduce((s,d)=>s+dayTotalKm(local[d]),0);
  return h("div",null,
    groupName&&h("div",{style:{marginBottom:12,padding:"8px 12px",background:"#FEF3E0",borderRadius:8,fontSize:13,color:"#9A6610",fontWeight:500}},"📋 Group plan for: "+groupName),
    h("div",{style:{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:14,padding:"10px 14px",background:"#F7F8FA",borderRadius:8}},
      h("span",{style:{fontSize:13,color:"#4A5568"}},"Weekly volume"),
      h("span",{className:"mono",style:{fontSize:18,fontWeight:700}},"Total volume: "+Math.round(totalKm)+" km")
    ),
    DAYS.map(day=>{
      const d=local[day],isRest=d.restDay||d.sessions.length===0;
      return h("div",{key:day,style:{border:"0.5px solid #E2E8F0",borderRadius:10,padding:"12px 14px",marginBottom:8,background:isRest?"#FAFBFC":"#fff"}},
        h("div",{style:{display:"flex",alignItems:"center",gap:8,marginBottom:isRest?0:10}},
          h("div",{style:{fontSize:11,fontWeight:700,color:"#8A9BB0",width:28,textTransform:"uppercase",letterSpacing:"0.06em",flexShrink:0}},day),
          h("label",{style:{display:"flex",alignItems:"center",gap:6,fontSize:13,cursor:"pointer",userSelect:"none"}},
            h("input",{type:"checkbox",checked:!isRest,onChange:()=>toggleRest(day),style:{width:15,height:15,cursor:"pointer",accentColor:"#F5A623"}}),
            h("span",{style:{color:isRest?"#8A9BB0":"#0F1117",fontWeight:isRest?400:500}},isRest?"Rest / Off day":"Training day")
          ),
          !isRest&&h("button",{onClick:()=>addSess(day),className:"btn btns",style:{marginLeft:"auto"}},"+  Add session")
        ),
        !isRest&&d.sessions.map((sess,i)=>h(SessionEditor,{key:i,session:sess,index:i,total:d.sessions.length,onChange:s=>updSess(day,i,s),onRemove:()=>remSess(day,i)}))
      );
    }),
    h("div",{style:{display:"flex",gap:8,justifyContent:"flex-end",marginTop:8}},
      h("button",{className:"btn",onClick:onCancel},"Cancel"),
      h("button",{className:"btnp",onClick:()=>onSave(local)},"Save plan")
    )
  );
};

