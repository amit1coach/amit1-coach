  if (type==="strength") return h("div",{style:{display:"grid",gridTemplateColumns:"1fr 1fr",gap:10,marginBottom:8}},
    h("div",null,h("label",{className:"lbl"},"Duration (minutes)"),h("input",{type:"number",value:f.duration||"",onChange:e=>s("duration",e.target.value),placeholder:"e.g. 45"})),
    h("div",null,h("label",{className:"lbl"},"Actual distance (km) — optional"),h("input",{type:"number",value:f.actualDistance||"",onChange:e=>s("actualDistance",e.target.value),placeholder:"0",className:"mono"}))
  );

  if (type==="race") return h("div",{style:{marginBottom:8}},
    h("div",{style:{display:"grid",gridTemplateColumns:"1fr 1fr",gap:10,marginBottom:8}},
      h("div",null,h("label",{className:"lbl"},"Finish time (hh:mm:ss)"),h("input",{value:f.finishTime||"",onChange:e=>s("finishTime",e.target.value),placeholder:"e.g. 1:23:45",className:"mono"})),
      h("div",null,h("label",{className:"lbl"},"Official distance (km)"),h("input",{type:"number",value:f.actualDistance||"",onChange:e=>s("actualDistance",e.target.value),placeholder:"e.g. 10",className:"mono"}))
    ),
    h("div",null,
      h("label",{className:"lbl"},"Splits (write freely)"),
      h("textarea",{value:f.splits||"",onChange:e=>s("splits",e.target.value),rows:3,placeholder:"e.g. 5km: 22:30 | 10km: 45:10 | 15km: 1:08:20"})
    )
  );

  // Default fallback
  return h("div",{style:{display:"grid",gridTemplateColumns:"1fr 1fr",gap:10,marginBottom:8}},
    h("div",null,h("label",{className:"lbl"},"Actual distance (km)"),h("input",{type:"number",value:f.actualDistance||"",onChange:e=>s("actualDistance",e.target.value),placeholder:"0",className:"mono"})),
    h("div",null,h("label",{className:"lbl"},"Actual pace (mm:ss)"),h("input",{value:f.actualPace||"",onChange:e=>s("actualPace",e.target.value),placeholder:"e.g. 5:00",className:"mono"}))
  );
};

const PartRepForm = ({part, index, total, existing, onChange}) => {
  const wt = WT[part.type]||WT.easy;
  const [typeData, setTypeData] = useState(existing?.typeData||{actualDistance:part.distance||""});
  const emit = (td) => onChange({...existing, typeData:td, actualDistance:td.actualDistance||part.distance||""});

  return h("div",{style:{padding:"8px 10px", marginBottom:6, borderRadius:6, background:"#fff", borderLeft:`3px solid ${wt.color}`, border:`0.5px solid ${wt.color}33`, borderLeft:`3px solid ${wt.color}`}},
    h("div",{style:{fontSize:11, fontWeight:700, color:wt.dark, marginBottom:6}},
      (total>1?"Part "+(index+1)+": ":"")+wt.label+(part.distance?" · Planned: "+part.distance+"km":"")
    ),
    h(TypedRepFields,{type:part.type, existing:typeData, planPart:part, onChange:td=>{ setTypeData(td); emit(td); }})
  );
};

const SessRepForm = ({session, existing, onChange}) => {
  const parts = session.parts||[{type:"easy",distance:"",pace:""}];
  const wt = WT[sessFirstType(session)]||WT.easy;
  const km = sessTotalKm(session);
  const multiPart = parts.length > 1;

  const initPartReps = parts.map((p,i) => existing?.partReps?.[i]||{typeData:{actualDistance:p.distance||""}});
  const [partReps, setPartReps] = useState(initPartReps);
  const [f, setF] = useState(existing||{status:"done", effort:"6", hr:"", notes:""});

  const s = (k,v) => { const nx={...f,[k]:v}; setF(nx); emitAll(nx, partReps); };
  const updatePart = (i,v) => { const n=[...partReps]; n[i]=v; setPartReps(n); emitAll(f,n); };
  const emitAll = (ff, pr) => {
    const totalActual = pr.reduce((s,p)=>s+(parseFloat(p.typeData?.actualDistance||p.actualDistance)||0),0);
