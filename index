  const addPart=()=>onChange({...session,parts:[...parts,newPart()]});
  const removePart=i=>onChange({...session,parts:parts.filter((_,idx)=>idx!==i)});
  const km=sessTotalKm(session);
  return h("div",{className:"sblk",style:{borderLeft:"3px solid #F5A623",marginBottom:10}},
    h("div",{style:{display:"flex",alignItems:"center",justifyContent:"space-between",marginBottom:8}},
      h("div",{style:{display:"flex",alignItems:"center",gap:8}},
