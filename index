    return h("div",{style:{marginBottom:8}},
      h("div",{style:{display:"grid",gridTemplateColumns:"1fr 1fr",gap:10,marginBottom:10}},
        h("div",null,h("label",{className:"lbl"},"Actual total distance (km)"),h("input",{type:"number",value:f.actualDistance||"",onChange:e=>s("actualDistance",e.target.value),placeholder:"0",className:"mono"})),
        h("div",null,h("label",{className:"lbl"},"Total average pace (mm:ss)"),h("input",{value:f.avgPace||"",onChange:e=>s("avgPace",e.target.value),placeholder:"e.g. 5:10",className:"mono"}))
      ),
      h("div",{style:{marginBottom:10}},
        h("label",{className:"lbl"},"Part 1 — base pace (mm:ss)"),
        h("input",{value:f.part1Pace||"",onChange:e=>s("part1Pace",e.target.value),placeholder:"e.g. 5:30",className:"mono"})
      ),
      h("div",{style:{marginBottom:8}},
        h("label",{className:"lbl"},"Part 2 — type"),
        h("div",{style:{display:"flex",gap:6,marginBottom:10}},
          ["steady","progression","speedgame"].map(t=>
            h("button",{key:t,onClick:()=>s("part2Type",t),style:{flex:1,padding:"6px 0",borderRadius:6,cursor:"pointer",fontWeight:600,fontSize:12,
              border:part2Type===t?"2px solid #F5A623":"0.5px solid #E2E8F0",
              background:part2Type===t?"#FEF3E0":"#fff",
              color:part2Type===t?"#9A6610":"#8A9BB0"
            }},t==="steady"?"Steady":t==="progression"?"Progression":"Speed game")
          )
        ),
        part2Type==="steady"&&h("div",null,
          h("label",{className:"lbl"},"Steady pace (mm:ss)"),
          h("input",{value:f.part2Pace||"",onChange:e=>s("part2Pace",e.target.value),placeholder:"e.g. 4:50",className:"mono"})
        ),
        part2Type==="progression"&&h("div",{style:{display:"grid",gridTemplateColumns:"1fr 1fr",gap:10}},
          h("div",null,h("label",{className:"lbl"},"Start pace (mm:ss)"),h("input",{value:f.progStart||"",onChange:e=>s("progStart",e.target.value),placeholder:"e.g. 5:10",className:"mono"})),
          h("div",null,h("label",{className:"lbl"},"Finish pace (mm:ss)"),h("input",{value:f.progEnd||"",onChange:e=>s("progEnd",e.target.value),placeholder:"e.g. 4:30",className:"mono"}))
        ),
