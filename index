.mb{background:#fff;border-radius:14px;padding:1.5rem;width:100%;max-height:90vh;overflow-y:auto;border:.5px solid #E2E8F0;box-shadow:0 20px 60px rgba(0,0,0,.15)}
.card{background:#fff;border:.5px solid #E2E8F0;border-radius:12px;padding:12px 16px;cursor:pointer;transition:border-color .15s}
