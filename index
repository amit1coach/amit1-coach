  if (type==="hills") {
    const planHillRows = planPart ? getHillRows(planPart) : [];
    const rows = getHillRows(f).length > 0 ? getHillRows(f) : (planHillRows.length > 0 ? planHillRows : [{sets:"",reps:"",distM:""}]);
    const updateRow = (i,k,v) => {
      const nr=[...rows]; nr[i]={...nr[i],[k]:v};
      s("hillRows",nr);
      const totalKm=nr.reduce((t,r)=>{
        const sets=parseFloat(r.sets)||1, reps=parseFloat(r.reps)||0, dist=parseFloat(r.distM)||0;
        return t+(sets*reps*dist/1000);
