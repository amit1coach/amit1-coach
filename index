.btn{border:.5px solid #CBD5E0;background:#fff;color:#0F1117;border-radius:6px;padding:8px 16px;font-size:14px;font-weight:500;cursor:pointer;display:inline-flex;align-items:center;gap:5px;transition:background .12s}
.btn:hover{background:#F7F8FA}
.btnp{border:none;background:#F5A623;color:#fff;border-radius:6px;padding:8px 16px;font-size:14px;font-weight:500;cursor:pointer;display:inline-flex;align-items:center;gap:5px}
.btnp:hover{background:#E09510}
.btns{padding:5px 12px;font-size:12px}
.btnd{border:.5px solid #E05C5C;background:#FFF0F0;color:#E05C5C;border-radius:6px;padding:5px 12px;font-size:12px;font-weight:500;cursor:pointer}
input[type=text],input[type=number],input[type=email],input[type=password],select,textarea{border:.5px solid #CBD5E0;border-radius:6px;padding:7px 10px;font-size:14px;background:#fff;color:#0F1117;width:100%}
textarea{resize:vertical}
input::placeholder{color:#CBD5E0;font-style:italic}
input.vague::placeholder{color:#E2E8F0;font-style:italic;font-weight:300}
.lbl{font-size:12px;font-weight:500;color:#4A5568;display:block;margin-bottom:4px}
.sc{background:#F7F8FA;border-radius:10px;padding:14px 16px;flex:1}
